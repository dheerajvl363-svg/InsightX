# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dependencies and build output
node_modules/
dist/
build/
coverage/
.cache/

# Python artifacts
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local data: never commit platform exports, credentials, or downloaded datasets.
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Logs
*.log
