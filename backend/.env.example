# =============================================================================
# InsightX Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
# =============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/insightx

# Application Environment (development, testing, production)
APP_ENV=development

# Application Version
APP_VERSION=5.1.0

# Debug Mode (true/false)
DEBUG=false

# CORS Allowed Origins
# Comma-separated list of allowed web origins for browser API access.
# If unset in development, defaults to standard local development ports:
#   http://localhost:3000, http://127.0.0.1:3000 (Next.js / CRA)
#   http://localhost:5173, http://127.0.0.1:5173 (Vite)
#   http://localhost:8080, http://127.0.0.1:8080 (Vue)
# In production, explicit origin(s) must be specified (defaults to empty list).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
